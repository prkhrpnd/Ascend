# ====================================================================
# ASCEND ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# If these variables are not provided, Ascend automatically runs in
# secure isolated local sandbox mode (in-memory + localStorage).
# ====================================================================

# 1. SUPABASE CREDENTIALS (OPTIONAL FOR CLOUD SYNC)
# Remote Supabase project URL and anonymous client API key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional service role key for backend admin functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. ACCOUNT AGGREGATOR (AA) PROVIDER SETTINGS (OPTIONAL)
# If not configured, Ascend runs an interactive simulated AA sandbox
NEXT_PUBLIC_AA_PROVIDER=mock
AA_CLIENT_ID=your-aa-client-id
AA_CLIENT_SECRET=your-aa-client-secret
AA_REDIRECT_URL=http://localhost:3000/api/aa/callback

# 3. AI EXPLANATIONS API (OPTIONAL)
# Google Gemini API key for natural language narration classification
GEMINI_API_KEY=your-gemini-api-key-here
